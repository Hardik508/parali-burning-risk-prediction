{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run demo",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "run_demo.py",
        "--out",
        "../demo_output"
      ],
      "options": {
        "cwd": "${workspaceFolder}/code"
      },
      "problemMatcher": []
    },
    {
      "label": "Open demo report",
      "type": "shell",
      "command": "start \"\" demo_output\\demo_report.html",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Open risk map",
      "type": "shell",
      "command": "start \"\" demo_output\\risk_map.html",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}